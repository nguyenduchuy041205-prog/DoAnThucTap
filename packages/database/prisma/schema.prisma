// =============================================================================
// HTX CHĂN NUÔI & TRUY XUẤT NGUỒN GỐC (LIVESTOCK COOP)
// Database: PostgreSQL via Prisma
// Đáp ứng trọn vẹn 10 phân hệ nghiệp vụ theo chuẩn Chuyển đổi số HTX
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, uuid_ossp]
}

// =============================================================================
// ENUMS
// =============================================================================

enum RoleCode {
  SUPER_ADMIN      // Quản trị toàn hệ thống
  COOP_ADMIN       // Ban quản trị Hợp tác xã
  VETERINARIAN     // Cán bộ thú y / Kỹ thuật chăn nuôi
  ACCOUNTANT       // Kế toán kho & tài chính
  FARMER_HOUSEHOLD // Hộ chăn nuôi thành viên
  BUYER            // Khách hàng / Thương lái / Đối tác bao tiêu
  GUEST            // Khách vãng lai xem QR truy xuất
}

enum LivestockType {
  PIG        // Heo / Lợn (thịt, nái, giống)
  CATTLE     // Bò (thịt, sữa)
  POULTRY    // Gia cầm (gà, vịt)
  GOAT       // Dê / Cừu
  OTHER      // Khác
}

enum HerdStatus {
  QUARANTINE_IN   // Đang cách ly nhập đàn
  RAISING         // Đang nuôi lớn / sinh trưởng
  TREATMENT       // Đang điều trị dịch bệnh
  WITHDRAWAL_WAIT // Đang chờ hết thời gian ngưng thuốc (đảm bảo ATVSTP)
  READY_TO_SELL   // Đạt chuẩn xuất chuồng
  SOLD_OUT        // Đã xuất bán toàn bộ
  CULLED          // Đã thanh lý / tiêu hủy
}

enum MaterialType {
  FEED            // Thức ăn tinh, thức ăn hỗn hợp, cám
  VET_MEDICINE    // Thuốc thú y, kháng sinh, thuốc bổ
  VACCINE         // Vắc-xin phòng bệnh
  DISINFECTANT    // Hóa chất sát trùng, khử trùng chuồng trại
  EQUIPMENT       // Vật tư, công cụ chăn nuôi
}

enum HealthCondition {
  HEALTHY         // Khỏe mạnh bình thường
  MONITORING      // Đang theo dõi nghi ngờ
  SICK            // Nhiễm bệnh / Triệu chứng
  TREATED         // Đã hồi phục sau điều trị
  ISOLATED        // Đang cách ly riêng
}

enum MovementType {
  IMPORT          // Nhập đàn con giống mới
  EXPORT_SALE     // Xuất chuồng bán thịt / thương phẩm
  TRANSFER_PEN    // Chuyển chuồng trại nội bộ
  CULLED_DEATH    // Hao hụt, loại thải hoặc chết
}

enum QrStatus {
  PENDING         // Đang chờ duyệt hồ sơ
  ACTIVE          // Đã cấp mã QR truy xuất hợp lệ
  REVOKED         // Bị thu hồi (phát hiện dư lượng thuốc/vi phạm)
  EXPIRED         // Hết hạn lô hàng
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

// =============================================================================
// PHÂN HỆ 1: QUẢN LÝ THÀNH VIÊN VÀ HỘ CHĂN NUÔI
// =============================================================================

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String    @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(150)
  phone        String?   @db.VarChar(20)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  roles        UserRole[]
  household    FarmerHousehold?
  createdHerds HerdBatch[]      @relation("CreatedByUser")
  healthLogs   HealthLog[]      @relation("VetDoctor")
  orders       Order[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        RoleCode  @unique
  name        String    @db.VarChar(100)
  description String?   @db.Text
  permissions Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")

  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@map("user_roles")
}

/// Hộ chăn nuôi thành viên HTX
model FarmerHousehold {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  householdCode  String    @unique @map("household_code") @db.VarChar(30) // VD: HCN-MT-001
  householderName String   @map("householder_name") @db.VarChar(150)
  nationalId     String?   @map("national_id") @db.VarChar(50) // CCCD đại diện hộ
  phone          String    @db.VarChar(20)
  address        String    @db.Text
  commune        String?   @db.VarChar(100) // Xã Tân Phú
  district       String?   @db.VarChar(100) // Huyện Tân Châu
  province       String    @default("Tây Ninh") @db.VarChar(100)
  farmLatitude   Decimal?  @map("farm_latitude") @db.Decimal(10, 7)
  farmLongitude  Decimal?  @map("farm_longitude") @db.Decimal(10, 7)
  capacityHead   Int       @default(100) @map("capacity_head") // Sức chứa tối đa (con)
  bioSecurityCert String?  @map("biosecurity_cert") @db.VarChar(100) // Giấy chứng nhận an toàn sinh học / VietGAHP
  certIssueDate  DateTime? @map("cert_issue_date") @db.Date
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  barns          Barn[]
  herds          HerdBatch[]
  contracts      Contract[]

  @@map("farmer_households")
}

/// Chuồng / Dãy nuôi tại hộ
model Barn {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId   String    @map("household_id") @db.Uuid
  barnCode      String    @map("barn_code") @db.VarChar(30) // C01, C02
  name          String    @db.VarChar(100)
  areaM2        Decimal?  @map("area_m2") @db.Decimal(8, 2)
  maxCapacity   Int       @map("max_capacity") // Sức chứa thiết kế
  currentStock  Int       @default(0) @map("current_stock")
  notes         String?   @db.Text
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")

  household     FarmerHousehold @relation(fields: [householdId], references: [id], onDelete: Cascade)
  herds         HerdBatch[]

  @@unique([householdId, barnCode])
  @@map("barns")
}

// =============================================================================
// PHÂN HỆ 2: QUẢN LÝ ĐÀN, NHÓM VẬT NUÔI VÀ NGUỒN GIỐNG
// =============================================================================

model Breed {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  breedCode    String        @unique @map("breed_code") @db.VarChar(30) // HEO-DUROC, BO-BBB
  name         String        @db.VarChar(150)
  type         LivestockType
  origin       String?       @db.VarChar(150) // Cơ sở cung cấp giống gốc
  standardGrowthDays Int     @default(120) @map("standard_growth_days") // Chu kỳ nuôi chuẩn (ngày)
  targetWeightKg Decimal?    @map("target_weight_kg") @db.Decimal(6, 2) // Cân nặng chuẩn xuất chuồng
  description  String?       @db.Text

  herds        HerdBatch[]

  @@map("breeds")
}

/// Đàn / Nhóm vật nuôi (Đơn vị quản lý trung tâm của chăn nuôi)
model HerdBatch {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchCode        String          @unique @map("batch_code") @db.VarChar(50) // DAN-2026-H01-001
  householdId      String          @map("household_id") @db.Uuid
  barnId           String?         @map("barn_id") @db.Uuid
  breedId          String          @map("breed_id") @db.Uuid
  createdById      String?         @map("created_by_id") @db.Uuid

  animalType       LivestockType   @map("animal_type")
  initialQuantity  Int             @map("initial_quantity") // Số lượng nhập ban đầu
  currentQuantity  Int             @map("current_quantity") // Số lượng hiện tại
  deadQuantity     Int             @default(0) @map("dead_quantity") // Số lượng hao hụt/chết
  soldQuantity     Int             @default(0) @map("sold_quantity") // Số lượng đã xuất bán

  entryDate        DateTime        @map("entry_date") @db.Date // Ngày nhập đàn
  expectedExitDate DateTime?       @map("expected_exit_date") @db.Date // Ngày dự kiến xuất chuồng
  actualExitDate   DateTime?       @map("actual_exit_date") @db.Date

  avgEntryWeightKg Decimal         @map("avg_entry_weight_kg") @db.Decimal(6, 2) // Cân nặng TB lúc nhập
  avgCurrentWeightKg Decimal       @map("avg_current_weight_kg") @db.Decimal(6, 2) // Cân nặng TB hiện tại

  supplierName     String?         @map("supplier_name") @db.VarChar(200) // Nguồn cung cấp giống
  quarantineCertNo String?         @map("quarantine_cert_no") @db.VarChar(100) // Giấy kiểm dịch nguồn giống

  status           HerdStatus      @default(RAISING)
  
  // ── Kiểm soát ngưng thuốc (Withdrawal period) đảm bảo ATVSTP ─────────────
  lastMedicineDate DateTime?       @map("last_medicine_date") @db.Date
  requiredWithdrawalDays Int       @default(0) @map("required_withdrawal_days")
  safeHarvestDate  DateTime?       @map("safe_harvest_date") @db.Date // Ngày an toàn để xuất thịt

  notes            String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  household        FarmerHousehold @relation(fields: [householdId], references: [id], onDelete: Restrict)
  barn             Barn?           @relation(fields: [barnId], references: [id], onDelete: SetNull)
  breed            Breed           @relation(fields: [breedId], references: [id], onDelete: Restrict)
  createdBy        User?           @relation("CreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)

  growthLogs       GrowthLog[]
  feedingLogs      FeedingLog[]
  vaccinations     VaccinationSchedule[]
  healthLogs       HealthLog[]
  movements        HerdMovement[]
  traceQRs         AnimalTraceQR[]
  costReport       CostProfitSummary?

  @@index([householdId, status])
  @@index([safeHarvestDate])
  @@map("herd_batches")
}

// =============================================================================
// PHÂN HỆ 3: THEO DÕI QUÁ TRÌNH CHĂM SÓC VÀ TĂNG TRƯỞNG
// =============================================================================

/// Nhật ký cân đo định kỳ & tính FCR (Feed Conversion Ratio)
model GrowthLog {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  herdId          String    @map("herd_id") @db.Uuid
  recordDate      DateTime  @map("record_date") @db.Date
  daysOfAge       Int       @map("days_of_age") // Ngày tuổi
  sampleCount     Int       @default(10) @map("sample_count") // Số cá thể cân mẫu
  avgWeightKg     Decimal   @map("avg_weight_kg") @db.Decimal(6, 2)
  minWeightKg     Decimal?  @map("min_weight_kg") @db.Decimal(6, 2)
  maxWeightKg     Decimal?  @map("max_weight_kg") @db.Decimal(6, 2)
  dailyGainGram   Decimal?  @map("daily_gain_gram") @db.Decimal(6, 1) // Tăng trọng bình quân/ngày (ADG)
  calculatedFCR   Decimal?  @map("calculated_fcr") @db.Decimal(5, 2) // Hệ số chuyển hóa thức ăn FCR
  notes           String?   @db.Text
  recordedBy      String?   @map("recorded_by") @db.VarChar(100)
  createdAt       DateTime  @default(now()) @map("created_at")

  herd            HerdBatch @relation(fields: [herdId], references: [id], onDelete: Cascade)

  @@index([herdId, recordDate(sort: Desc)])
  @@map("growth_logs")
}

/// Nhật ký khẩu phần ăn & tiêu thụ thức ăn hàng ngày
model FeedingLog {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  herdId          String    @map("herd_id") @db.Uuid
  feedingDate     DateTime  @map("feeding_date") @db.Date
  materialId      String    @map("material_id") @db.Uuid // Loại thức ăn
  quantityKg      Decimal   @map("quantity_kg") @db.Decimal(8, 2)
  waterLiters     Decimal?  @map("water_liters") @db.Decimal(8, 2)
  stage           String?   @db.VarChar(50) // "Giai đoạn úm", "Vỗ béo", "Nuôi thịt"
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")

  herd            HerdBatch @relation(fields: [herdId], references: [id], onDelete: Cascade)
  material        Material  @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([herdId, feedingDate(sort: Desc)])
  @@map("feeding_logs")
}

// =============================================================================
// PHÂN HỆ 4: QUẢN LÝ THỨC ĂN, THUỐC THÚ Y VÀ VẬT TƯ
// =============================================================================

model Material {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String       @unique @db.VarChar(30) // TA-CP-01, VAX- dịch tả
  name                 String       @db.VarChar(200)
  type                 MaterialType
  unit                 String       @db.VarChar(30) // kg, bao 25kg, lọ, liều, lít
  manufacturer         String?      @db.VarChar(200) // De Heus, CP, Navetco...
  currentStock         Decimal      @default(0) @map("current_stock") @db.Decimal(12, 2)
  minStockAlert        Decimal      @default(10) @map("min_stock_alert") @db.Decimal(12, 2)
  unitPrice            Decimal?     @map("unit_price") @db.Decimal(12, 2)

  /// Thời gian ngưng thuốc bắt buộc trước khi giết mổ (ngày)
  withdrawalDays       Int          @default(0) @map("withdrawal_days")

  activeIngredient     String?      @map("active_ingredient") @db.Text // Hoạt chất
  usageGuidelines      String?      @map("usage_guidelines") @db.Text
  isActive             Boolean      @default(true) @map("is_active")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  transactions         InventoryTransaction[]
  feedingLogs          FeedingLog[]
  vaccinationSchedules VaccinationSchedule[]
  treatmentLogs        TreatmentMedicine[]

  @@map("materials")
}

model InventoryTransaction {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId      String    @map("material_id") @db.Uuid
  transactionType String    @map("transaction_type") @db.VarChar(20) // "IMPORT", "EXPORT", "RETURN"
  quantity        Decimal   @db.Decimal(12, 2)
  balanceAfter    Decimal   @map("balance_after") @db.Decimal(12, 2)
  unitPrice       Decimal?  @map("unit_price") @db.Decimal(12, 2)
  totalValue      Decimal?  @map("total_value") @db.Decimal(14, 2)
  invoiceNo       String?   @map("invoice_no") @db.VarChar(100)
  targetRecipient String?   @map("target_recipient") @db.VarChar(150) // Xuất cho hộ nào / đàn nào
  transactedAt    DateTime  @map("transacted_at") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")

  material        Material  @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([materialId, transactedAt(sort: Desc)])
  @@map("inventory_transactions")
}

// =============================================================================
// PHÂN HỆ 5: LỊCH TIÊM PHÒNG, VỆ SINH VÀ KHỬ TRÙNG
// =============================================================================

model VaccinationSchedule {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  herdId          String    @map("herd_id") @db.Uuid
  materialId      String?   @map("material_id") @db.Uuid // Loại vắc-xin hoặc hóa chất khử trùng
  title           String    @db.VarChar(200) // Tiêm vắc-xin Dịch tả lợn châu Phi, Phun sát trùng chuồng
  targetAgeDays   Int?      @map("target_age_days") // Lịch tiêm tại ngày tuổi thứ mấy
  scheduledDate   DateTime  @map("scheduled_date") @db.Date
  executedDate    DateTime? @map("executed_date") @db.Date
  dosagePerHead   String?   @map("dosage_per_head") @db.VarChar(50) // Liều lượng (2ml/con)
  administeredBy  String?   @map("administered_by") @db.VarChar(100) // Cán bộ thú y thực hiện
  isCompleted     Boolean   @default(false) @map("is_completed")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")

  herd            HerdBatch @relation(fields: [herdId], references: [id], onDelete: Cascade)
  material        Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([herdId, scheduledDate])
  @@index([isCompleted])
  @@map("vaccination_schedules")
}

// =============================================================================
// PHÂN HỆ 6: THEO DÕI SỨC KHỎE, DỊCH BỆNH VÀ ĐIỀU TRỊ
// =============================================================================

model HealthLog {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  herdId          String          @map("herd_id") @db.Uuid
  reportedDate    DateTime        @map("reported_date") @db.Date
  affectedCount   Int             @default(1) @map("affected_count") // Số lượng cá thể nhiễm
  condition       HealthCondition @default(MONITORING)
  symptoms        String          @db.Text // Sốt, bỏ ăn, tiêu chảy, ho...
  diagnosis       String?         @db.Text // Chẩn đoán bệnh
  isolationRoom   String?         @map("isolation_room") @db.VarChar(100) // Chuồng cách ly
  vetDoctorId     String?         @map("vet_doctor_id") @db.Uuid
  notes           String?         @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")

  herd            HerdBatch       @relation(fields: [herdId], references: [id], onDelete: Cascade)
  vetDoctor       User?           @relation("VetDoctor", fields: [vetDoctorId], references: [id], onDelete: SetNull)
  treatments      TreatmentMedicine[]

  @@index([herdId, reportedDate(sort: Desc)])
  @@map("health_logs")
}

model TreatmentMedicine {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  healthLogId     String    @map("health_log_id") @db.Uuid
  materialId      String    @map("material_id") @db.Uuid // Thuốc kháng sinh / điều trị
  dosage          String    @db.VarChar(100)
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime  @map("end_date") @db.Date
  withdrawalDays  Int       @default(14) @map("withdrawal_days") // Ngày ngưng thuốc bắt buộc
  createdAt       DateTime  @default(now()) @map("created_at")

  healthLog       HealthLog @relation(fields: [healthLogId], references: [id], onDelete: Cascade)
  material        Material  @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@map("treatment_medicines")
}

// =============================================================================
// PHÂN HỆ 7: QUẢN LÝ NHẬP ĐÀN, XUẤT ĐÀN VÀ TIÊU THỤ
// =============================================================================

model HerdMovement {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  herdId          String        @map("herd_id") @db.Uuid
  type            MovementType
  movementDate    DateTime      @map("movement_date") @db.Date
  quantity        Int
  totalWeightKg   Decimal?      @map("total_weight_kg") @db.Decimal(10, 2)
  unitPriceKg     Decimal?      @map("unit_price_kg") @db.Decimal(10, 2)
  totalValue      Decimal?      @map("total_value") @db.Decimal(14, 2)
  partnerName     String?       @map("partner_name") @db.VarChar(200) // Đơn vị mua / Cty giết mổ
  vehicleNumber   String?       @map("vehicle_number") @db.VarChar(50) // Biển kiểm soát xe chuyên chở
  vetInspectionDoc String?      @map("vet_inspection_doc") @db.VarChar(500) // Link chứng nhận kiểm dịch vận chuyển
  reason          String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")

  herd            HerdBatch     @relation(fields: [herdId], references: [id], onDelete: Cascade)

  @@index([herdId, movementDate(sort: Desc)])
  @@map("herd_movements")
}

// =============================================================================
// PHÂN HỆ 8: TRUY XUẤT NGUỒN GỐC VẬT NUÔI HOẶC SẢN PHẨM (HỘ CHIẾU SỐ & QR)
// =============================================================================

model AnimalTraceQR {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  herdId          String    @map("herd_id") @db.Uuid
  token           String    @unique @db.VarChar(100) // Token bí mật tra cứu URL
  productBatchCode String   @map("product_batch_code") @db.VarChar(50) // Mã lô thịt / sản phẩm: THIT-HEO-2026-01
  status          QrStatus  @default(ACTIVE)

  // ── Điều kiện xuất mã QR an toàn (3 lớp kiểm chứng) ──────────────────────
  conditionVaccinationOk Boolean @default(true) @map("condition_vaccination_ok") // Đã tiêm đủ vắc-xin bắt buộc
  conditionWithdrawalOk  Boolean @default(true) @map("condition_withdrawal_ok")  // Đã hết thời gian ngưng thuốc kháng sinh
  conditionVetCheckedOk  Boolean @default(true) @map("condition_vet_checked_ok")  // Thú y xác nhận không nhiễm dịch

  publicUrl       String    @map("public_url") @db.VarChar(500)
  qrImageUrl      String?   @map("qr_image_url") @db.VarChar(500)
  snapshotData    Json?     @map("snapshot_data") // Lưu snapshot toàn bộ lý lịch đàn
  scanCount       Int       @default(0) @map("scan_count")
  lastScannedAt   DateTime? @map("last_scanned_at")
  issuedAt        DateTime  @default(now()) @map("issued_at")

  herd            HerdBatch @relation(fields: [herdId], references: [id], onDelete: Restrict)
  orders          Order[]

  @@index([token])
  @@map("animal_trace_qrs")
}

// =============================================================================
// PHÂN HỆ 9: QUẢN LÝ KHÁCH HÀNG, ĐƠN HÀNG VÀ HỢP ĐỒNG
// =============================================================================

model Contract {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractNo      String      @unique @map("contract_no") @db.VarChar(50) // HD-BAOTIEU-2026-01
  householdId     String      @map("household_id") @db.Uuid
  buyerName       String      @map("buyer_name") @db.VarChar(200) // Cty Thực Phẩm Sạch Vissan, CP...
  buyerPhone      String      @map("buyer_phone") @db.VarChar(20)
  contractType    String      @map("contract_type") @db.VarChar(50) // "BAO_TIEU_DAU_RA", "CUNG_UNG_GIONG"
  signedDate      DateTime    @map("signed_date") @db.Date
  expiryDate      DateTime    @map("expiry_date") @db.Date
  committedQtyHead Int        @map("committed_qty_head") // Sản lượng cam kết (con)
  contractValue   Decimal?    @map("contract_value") @db.Decimal(14, 2)
  fileScanUrl     String?     @map("file_scan_url") @db.VarChar(500)
  status          String      @default("ACTIVE") @db.VarChar(30)
  createdAt       DateTime    @default(now()) @map("created_at")

  household       FarmerHousehold @relation(fields: [householdId], references: [id], onDelete: Restrict)
  orders          Order[]

  @@map("contracts")
}

model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNo         String      @unique @map("order_no") @db.VarChar(50) // DH-2026-001
  contractId      String?     @map("contract_id") @db.Uuid
  traceQrId       String?     @map("trace_qr_id") @db.Uuid
  customerUserId  String?     @map("customer_user_id") @db.Uuid

  customerName    String      @map("customer_name") @db.VarChar(150)
  customerPhone   String      @map("customer_phone") @db.VarChar(20)
  customerAddress String?     @map("customer_address") @db.Text
  totalAmount     Decimal     @map("total_amount") @db.Decimal(14, 2)
  status          OrderStatus @default(DRAFT)
  deliveryDate    DateTime?   @map("delivery_date") @db.Date
  notes           String?     @db.Text
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  contract        Contract?      @relation(fields: [contractId], references: [id], onDelete: SetNull)
  traceQr         AnimalTraceQR? @relation(fields: [traceQrId], references: [id], onDelete: SetNull)
  customer        User?          @relation(fields: [customerUserId], references: [id], onDelete: SetNull)

  @@map("orders")
}

// =============================================================================
// PHÂN HỆ 10: TỔNG HỢP CHI PHÍ, SẢN LƯỢNG VÀ HIỆU QUẢ CHĂN NUÔI
// =============================================================================

model CostProfitSummary {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  herdId            String    @unique @map("herd_id") @db.Uuid
  
  // Chi phí (VNĐ)
  breedCost         Decimal   @default(0) @map("breed_cost") @db.Decimal(14, 2) // Tiền con giống
  feedCost          Decimal   @default(0) @map("feed_cost") @db.Decimal(14, 2)  // Tiền thức ăn cám
  vetCost           Decimal   @default(0) @map("vet_cost") @db.Decimal(14, 2)   // Tiền thuốc thú y & vắc-xin
  laborCost         Decimal   @default(0) @map("labor_cost") @db.Decimal(14, 2) // Nhân công chăm sóc
  otherCost         Decimal   @default(0) @map("other_cost") @db.Decimal(14, 2) // Điện nước, khử trùng, khấu hao chuồng
  totalCost         Decimal   @default(0) @map("total_cost") @db.Decimal(14, 2)

  // Sản lượng & Doanh thu
  totalWeightSoldKg Decimal   @default(0) @map("total_weight_sold_kg") @db.Decimal(10, 2)
  totalRevenue      Decimal   @default(0) @map("total_revenue") @db.Decimal(14, 2)
  netProfit         Decimal   @default(0) @map("net_profit") @db.Decimal(14, 2) // Lợi nhuận ròng
  
  // Chỉ số hiệu quả kinh tế & kỹ thuật
  finalFCR          Decimal?  @map("final_fcr") @db.Decimal(5, 2) // Hệ số FCR toàn chu kỳ
  survivalRate      Decimal?  @map("survival_rate") @db.Decimal(5, 2) // Tỷ lệ sống sót (%)
  profitPerHead     Decimal?  @map("profit_per_head") @db.Decimal(12, 2) // Lợi nhuận / con

  calculatedAt      DateTime  @default(now()) @map("calculated_at")

  herd              HerdBatch @relation(fields: [herdId], references: [id], onDelete: Cascade)

  @@map("cost_profit_summaries")
}

// =============================================================================
// AUDIT LOG & HỆ THỐNG
// =============================================================================

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.VarChar(100)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("audit_logs")
}
