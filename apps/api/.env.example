PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://cropcoop:cropcoop_dev_password@localhost:5432/cropcoop_dev?schema=public

# JWT
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d

# App
APP_NAME="CROP COOP API"
APP_VERSION="1.0.0"
PUBLIC_TRACE_BASE_URL=http://localhost:5173

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

