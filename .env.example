# PostgreSQL (Docker Compose)
POSTGRES_USER=cropcoop
POSTGRES_PASSWORD=cropcoop_dev_password
POSTGRES_DB=cropcoop_dev
POSTGRES_PORT=5432

# Local application ports
API_PORT=3000
WEB_PORT=5173

# API runtime
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cropcoop:cropcoop_dev_password@localhost:5432/cropcoop_dev?schema=public
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
PUBLIC_TRACE_BASE_URL=http://localhost:5173

# Vite uses this URL in the browser, so localhost is intentional here.
VITE_API_URL=http://localhost:3000/api/v1
